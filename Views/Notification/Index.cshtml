@model List<PadiPay.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    var currentFilter = ViewBag.Filter as string ?? "all";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <!-- Header Card -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 46px; height: 46px; font-size: 1.3rem;">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">Notifications</h4>
                        <p class="text-muted small mb-0">Stay updated on your orders, escrow milestones, and messages</p>
                    </div>
                </div>
                @if (unreadCount > 0)
                {
                    <button id="btnMarkAllRead" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
                        <i class="bi bi-check2-all me-1"></i> Mark all as read
                    </button>
                }
            </div>

            <!-- Filter Tabs -->
            <ul class="nav nav-pills mb-4 gap-2">
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == "all" ? "active" : "") rounded-pill px-3 py-1.5 fw-semibold small" 
                       asp-action="Index" asp-route-filter="all">
                        All
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == "unread" ? "active" : "") rounded-pill px-3 py-1.5 fw-semibold small d-flex align-items-center gap-2" 
                       asp-action="Index" asp-route-filter="unread">
                        Unread
                        @if (unreadCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill">@unreadCount</span>
                        }
                    </a>
                </li>
            </ul>

            <!-- Notifications List -->
            @if (Model == null || !Model.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3">
                    <div class="mb-3 text-muted" style="font-size: 3rem;">
                        <i class="bi bi-bell-slash"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">No notifications yet</h6>
                    <p class="text-muted small mb-0">
                        @(currentFilter == "unread" ? "You have no unread notifications right now." : "We'll notify you when there's an update on your escrow orders or account.")
                    </p>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="list-group list-group-flush">
                        @foreach (var n in Model)
                        {
                            var iconClass = n.Type switch
                            {
                                PadiPay.Models.NotificationType.OrderPlaced => "bi-box-seam text-primary",
                                PadiPay.Models.NotificationType.WorkDelivered => "bi-rocket-takeoff-fill text-info",
                                PadiPay.Models.NotificationType.RevisionRequested => "bi-arrow-repeat text-warning",
                                PadiPay.Models.NotificationType.OrderCompleted => "bi-check-circle-fill text-success",
                                PadiPay.Models.NotificationType.DisputeRaised => "bi-exclamation-triangle-fill text-danger",
                                PadiPay.Models.NotificationType.DisputeResolved => "bi-shield-check text-purple",
                                PadiPay.Models.NotificationType.MessageReceived => "bi-chat-dots-fill text-primary",
                                PadiPay.Models.NotificationType.WalletFunded => "bi-wallet2 text-success",
                                _ => "bi-bell-fill text-secondary"
                            };

                            var bgClass = n.IsRead ? "bg-white" : "bg-light bg-opacity-75";

                            <div class="list-group-item list-group-item-action p-3 border-bottom d-flex align-items-start gap-3 @bgClass transition-all" 
                                 id="notif-item-@n.Id">
                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-white shadow-sm flex-shrink-0" 
                                     style="width: 40px; height: 40px; font-size: 1.1rem; border: 1px solid rgba(0,0,0,0.06);">
                                    <i class="bi @iconClass"></i>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                        <h6 class="fw-bold mb-0 text-dark small text-truncate">@n.Title</h6>
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <span class="text-muted" style="font-size: 0.75rem;">@n.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</span>
                                            @if (!n.IsRead)
                                            {
                                                <span class="badge bg-primary p-1 rounded-circle" style="width: 8px; height: 8px;" title="Unread"></span>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-secondary small mb-2" style="font-size: 0.85rem; line-height: 1.4;">@n.Message</p>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(n.TargetUrl))
                                        {
                                            <a href="@n.TargetUrl" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold small text-primary notif-link" 
                                               data-id="@n.Id">
                                                View Details <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        }
                                        @if (!n.IsRead)
                                        {
                                            <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted small btn-mark-read" data-id="@n.Id">
                                                Mark as read
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Mark all as read
        const btnMarkAll = document.getElementById('btnMarkAllRead');
        if (btnMarkAll) {
            btnMarkAll.addEventListener('click', async function () {
                try {
                    const response = await fetch('/Notification/MarkAllAsRead', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });
                    if (response.ok) {
                        window.location.reload();
                    }
                } catch (e) {
                    console.error(e);
                }
            });
        }

        // Mark single as read
        document.querySelectorAll('.btn-mark-read').forEach(btn => {
            btn.addEventListener('click', async function (e) {
                e.preventDefault();
                const notifId = this.getAttribute('data-id');
                try {
                    const response = await fetch('/Notification/MarkAsRead?id=' + notifId, {
                        method: 'POST'
                    });
                    if (response.ok) {
                        window.location.reload();
                    }
                } catch (e) {
                    console.error(e);
                }
            });
        });

        // Click on notif link also marks as read
        document.querySelectorAll('.notif-link').forEach(link => {
            link.addEventListener('click', function () {
                const notifId = this.getAttribute('data-id');
                fetch('/Notification/MarkAsRead?id=' + notifId, { method: 'POST' });
            });
        });
    });
</script>
}
