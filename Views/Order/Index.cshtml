@{
    ViewData["Title"] = "My Escrow Orders - PadiPay";
    var activeTab = (string)(ViewBag.ActiveTab ?? "buying");
    var buyingOrders = (List<PadiPay.Models.Order>)(ViewBag.BuyingOrders ?? new List<PadiPay.Models.Order>());
    var sellingOrders = (List<PadiPay.Models.Order>)(ViewBag.SellingOrders ?? new List<PadiPay.Models.Order>());
}

<div class="pp-fade-in pb-5">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Escrow Orders</h2>
            <p class="text-muted small mb-0">Track project milestones, deliverables, revisions, and escrow fund releases.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Gig" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-grid-fill me-1"></i> Explore Gigs
            </a>
            <a asp-controller="Wallet" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-wallet2 me-1"></i> My Wallet
            </a>
        </div>
    </div>

    <!-- Tab Navigation -->
    <ul class="nav nav-pills mb-4 p-1.5 bg-light rounded-pill d-inline-flex border" id="orderTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link rounded-pill px-4 fw-bold @(activeTab == "buying" ? "active bg-primary text-white" : "text-muted")" 
               asp-action="Index" asp-route-tab="buying">
                <i class="bi bi-bag-check-fill me-1.5"></i> Purchased Orders (@buyingOrders.Count)
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link rounded-pill px-4 fw-bold @(activeTab == "selling" ? "active bg-primary text-white" : "text-muted")" 
               asp-action="Index" asp-route-tab="selling">
                <i class="bi bi-briefcase-fill me-1.5"></i> Client Orders (@sellingOrders.Count)
            </a>
        </li>
    </ul>

    <!-- Tab Content: Purchased Orders -->
    @if (activeTab == "buying")
    {
        @if (buyingOrders.Any())
        {
            <div class="pp-card shadow-sm border-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4 py-3">Order Details</th>
                                <th class="py-3">Seller</th>
                                <th class="py-3">Escrow Amount</th>
                                <th class="py-3">Delivery Turnaround</th>
                                <th class="py-3">Status</th>
                                <th class="pe-4 py-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in buyingOrders)
                            {
                                var statusClass = order.Status switch
                                {
                                    PadiPay.Models.OrderStatus.InProgress => "pp-badge-funded",
                                    PadiPay.Models.OrderStatus.Delivered => "pp-badge-delivered",
                                    PadiPay.Models.OrderStatus.InRevision => "bg-warning text-dark",
                                    PadiPay.Models.OrderStatus.Completed => "pp-badge-released",
                                    _ => "bg-secondary text-white"
                                };

                                var statusIcon = order.Status switch
                                {
                                    PadiPay.Models.OrderStatus.InProgress => "bi-hourglass-split",
                                    PadiPay.Models.OrderStatus.Delivered => "bi-box-seam-fill",
                                    PadiPay.Models.OrderStatus.InRevision => "bi-arrow-repeat",
                                    PadiPay.Models.OrderStatus.Completed => "bi-check2-circle",
                                    _ => "bi-info-circle"
                                };

                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark mb-0.5">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="text-dark text-decoration-none hover-primary">
                                                @(order.Gig?.Title ?? "Custom Tech Service")
                                            </a>
                                        </div>
                                        <div class="text-muted small">
                                            <span class="font-monospace text-primary fw-semibold">#@order.OrderNumber</span>
                                            &bull; @order.CreatedAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="pp-seller-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                @(string.IsNullOrWhiteSpace(order.Seller?.FullName) ? "S" : order.Seller.FullName.Trim()[0].ToString().ToUpper())
                                            </div>
                                            <div class="small fw-semibold text-dark text-truncate" style="max-width: 140px;">
                                                @(order.Seller?.FullName ?? "Freelancer")
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <span class="brand-font fw-bold text-success fs-6">₦@order.Amount.ToString("N0")</span>
                                    </td>
                                    <td class="py-3 small text-muted">
                                        @if (order.Status == PadiPay.Models.OrderStatus.Completed)
                                        {
                                            <span class="text-success"><i class="bi bi-check-all me-1"></i>Completed</span>
                                        }
                                        else if (order.DueDate.HasValue)
                                        {
                                            var daysLeft = (order.DueDate.Value - DateTime.UtcNow).Days;
                                            if (daysLeft >= 0)
                                            {
                                                <span><i class="bi bi-clock me-1 text-primary"></i>Due in @daysLeft Day@(daysLeft == 1 ? "" : "s")</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger fw-semibold"><i class="bi bi-exclamation-circle me-1"></i>Overdue</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>@order.DeliveryDays Days</span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <span class="badge @statusClass py-1 px-2.5 rounded-pill small">
                                            <i class="bi @statusIcon me-1"></i>@order.Status
                                        </span>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        @if (order.Status == PadiPay.Models.OrderStatus.Delivered)
                                        {
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-warning btn-sm fw-bold rounded-pill px-3 shadow-xs">
                                                Inspect & Release
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                                View Order
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="pp-card p-5 text-center shadow-sm">
                <div class="mb-3 text-muted">
                    <i class="bi bi-bag-x" style="font-size: 3.5rem;"></i>
                </div>
                <h5 class="fw-bold text-dark">No Purchased Orders Yet</h5>
                <p class="text-muted small mb-4">You haven't ordered any tech services. Explore vetted Nigerian engineers, designers, and tech pros with 100% escrow protection.</p>
                <a asp-controller="Gig" asp-action="Index" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-search me-1"></i> Explore Gigs Now
                </a>
            </div>
        }
    }
    else
    {
        <!-- Tab Content: Client Orders (Selling) -->
        @if (sellingOrders.Any())
        {
            <div class="pp-card shadow-sm border-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4 py-3">Order Details</th>
                                <th class="py-3">Buyer (Client)</th>
                                <th class="py-3">Payout Amount</th>
                                <th class="py-3">Turnaround / Due</th>
                                <th class="py-3">Status</th>
                                <th class="pe-4 py-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in sellingOrders)
                            {
                                var statusClass = order.Status switch
                                {
                                    PadiPay.Models.OrderStatus.InProgress => "pp-badge-funded",
                                    PadiPay.Models.OrderStatus.Delivered => "pp-badge-delivered",
                                    PadiPay.Models.OrderStatus.InRevision => "bg-warning text-dark",
                                    PadiPay.Models.OrderStatus.Completed => "pp-badge-released",
                                    _ => "bg-secondary text-white"
                                };

                                var statusIcon = order.Status switch
                                {
                                    PadiPay.Models.OrderStatus.InProgress => "bi-hourglass-split",
                                    PadiPay.Models.OrderStatus.Delivered => "bi-box-seam-fill",
                                    PadiPay.Models.OrderStatus.InRevision => "bi-arrow-repeat",
                                    PadiPay.Models.OrderStatus.Completed => "bi-check2-circle",
                                    _ => "bi-info-circle"
                                };

                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark mb-0.5">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="text-dark text-decoration-none hover-primary">
                                                @(order.Gig?.Title ?? "Custom Tech Service")
                                            </a>
                                        </div>
                                        <div class="text-muted small">
                                            <span class="font-monospace text-primary fw-semibold">#@order.OrderNumber</span>
                                            &bull; @order.CreatedAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="pp-seller-avatar" style="width: 32px; height: 32px; font-size: 0.8rem; background: linear-gradient(135deg, #4f46e5, #00C076);">
                                                @(string.IsNullOrWhiteSpace(order.Buyer?.FullName) ? "B" : order.Buyer.FullName.Trim()[0].ToString().ToUpper())
                                            </div>
                                            <div class="small fw-semibold text-dark text-truncate" style="max-width: 140px;">
                                                @(order.Buyer?.FullName ?? "Client")
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <span class="brand-font fw-bold text-success fs-6">₦@order.Amount.ToString("N0")</span>
                                    </td>
                                    <td class="py-3 small text-muted">
                                        @if (order.Status == PadiPay.Models.OrderStatus.Completed)
                                        {
                                            <span class="text-success"><i class="bi bi-cash-stack me-1"></i>Paid to Wallet</span>
                                        }
                                        else if (order.DueDate.HasValue)
                                        {
                                            var daysLeft = (order.DueDate.Value - DateTime.UtcNow).Days;
                                            if (daysLeft >= 0)
                                            {
                                                <span><i class="bi bi-clock me-1 text-primary"></i>@daysLeft Day@(daysLeft == 1 ? "" : "s") left</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger fw-semibold"><i class="bi bi-exclamation-circle me-1"></i>Overdue</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>@order.DeliveryDays Days</span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <span class="badge @statusClass py-1 px-2.5 rounded-pill small">
                                            <i class="bi @statusIcon me-1"></i>@order.Status
                                        </span>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        @if (order.Status == PadiPay.Models.OrderStatus.InProgress || order.Status == PadiPay.Models.OrderStatus.InRevision)
                                        {
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-emerald btn-sm fw-bold rounded-pill px-3 shadow-xs">
                                                Deliver Work
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                                View Order
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="pp-card p-5 text-center shadow-sm">
                <div class="mb-3 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3.5rem;"></i>
                </div>
                <h5 class="fw-bold text-dark">No Client Orders Yet</h5>
                <p class="text-muted small mb-4">Clients haven't booked your gigs yet. Make sure your gigs have competitive pricing, clear descriptions, and modern portfolio tags.</p>
                <a asp-controller="Gig" asp-action="Create" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-plus-circle me-1"></i> Post Another Gig
                </a>
            </div>
        }
    }
</div>
