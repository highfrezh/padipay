@model PadiPay.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.OrderNumber} - PadiPay";
    var isBuyer = (bool)(ViewBag.IsBuyer ?? false);
    var isSeller = (bool)(ViewBag.IsSeller ?? false);
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);

    var step2Completed = Model.Status == PadiPay.Models.OrderStatus.Delivered || Model.Status == PadiPay.Models.OrderStatus.Completed;
    var step2Active = Model.Status == PadiPay.Models.OrderStatus.InProgress || Model.Status == PadiPay.Models.OrderStatus.InRevision;
    var step3Completed = Model.Status == PadiPay.Models.OrderStatus.Completed;
    var step3Active = Model.Status == PadiPay.Models.OrderStatus.Delivered;
    var step4Completed = Model.Status == PadiPay.Models.OrderStatus.Completed;

    var statusBadgeClass = Model.Status switch
    {
        PadiPay.Models.OrderStatus.InProgress => "pp-badge-funded",
        PadiPay.Models.OrderStatus.Delivered => "pp-badge-delivered",
        PadiPay.Models.OrderStatus.InRevision => "bg-warning text-dark",
        PadiPay.Models.OrderStatus.Completed => "pp-badge-released",
        _ => "bg-secondary text-white"
    };
}

<div class="pp-fade-in pb-5">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">My Orders</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">#@Model.OrderNumber</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @statusBadgeClass py-1.5 px-3 rounded-pill fs-6">
                <i class="bi bi-shield-lock-fill me-1"></i> @Model.Status
            </span>
            <span class="brand-font fs-4 fw-bold text-success">₦@Model.Amount.ToString("N0")</span>
        </div>
    </div>

    <!-- 4-Step Escrow Timeline Visualizer -->
    <div class="pp-card p-4 mb-4 shadow-sm">
        <div class="row text-center g-2 position-relative">
            <!-- Step 1: Funded -->
            <div class="col-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2 text-white bg-success shadow-xs" style="width: 42px; height: 42px;">
                    <i class="bi bi-check-lg fs-5"></i>
                </div>
                <div class="small fw-bold text-dark">1. Escrow Funded</div>
                <div class="text-muted" style="font-size: 0.72rem;">@Model.CreatedAt.ToString("MMM dd")</div>
            </div>

            <!-- Step 2: In Progress -->
            <div class="col-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2 text-white @(step2Completed ? "bg-success" : (step2Active ? "bg-primary" : "bg-light text-muted border")) shadow-xs" style="width: 42px; height: 42px;">
                    @if (step2Completed)
                    {
                        <i class="bi bi-check-lg fs-5"></i>
                    }
                    else if (step2Active)
                    {
                        <i class="bi bi-gear-wide-connected fs-5 spin"></i>
                    }
                    else
                    {
                        <span class="text-muted fw-bold">2</span>
                    }
                </div>
                <div class="small fw-bold @(step2Active || step2Completed ? "text-dark" : "text-muted")">2. In Progress</div>
                <div class="text-muted" style="font-size: 0.72rem;">
                    @(Model.DueDate.HasValue ? $"Due {Model.DueDate.Value:MMM dd}" : "Working")
                </div>
            </div>

            <!-- Step 3: Delivered -->
            <div class="col-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2 text-white @(step3Completed ? "bg-success" : (step3Active ? "bg-warning text-dark" : "bg-light text-muted border")) shadow-xs" style="width: 42px; height: 42px;">
                    @if (step3Completed)
                    {
                        <i class="bi bi-check-lg fs-5"></i>
                    }
                    else if (step3Active)
                    {
                        <i class="bi bi-box-seam-fill fs-5"></i>
                    }
                    else
                    {
                        <span class="text-muted fw-bold">3</span>
                    }
                </div>
                <div class="small fw-bold @(step3Active || step3Completed ? "text-dark" : "text-muted")">3. Delivered</div>
                <div class="text-muted" style="font-size: 0.72rem;">
                    @(Model.DeliveredAt.HasValue ? Model.DeliveredAt.Value.ToString("MMM dd") : "Pending")
                </div>
            </div>

            <!-- Step 4: Completed -->
            <div class="col-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2 text-white @(step4Completed ? "bg-success" : "bg-light text-muted border") shadow-xs" style="width: 42px; height: 42px;">
                    @if (step4Completed)
                    {
                        <i class="bi bi-check2-all fs-4"></i>
                    }
                    else
                    {
                        <span class="text-muted fw-bold">4</span>
                    }
                </div>
                <div class="small fw-bold @(step4Completed ? "text-dark" : "text-muted")">4. Released & Completed</div>
                <div class="text-muted" style="font-size: 0.72rem;">
                    @(Model.CompletedAt.HasValue ? Model.CompletedAt.Value.ToString("MMM dd") : "Pending")
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Main Order Content & Action Areas -->
        <div class="col-lg-8">
            <!-- Alert Callouts for Actionable States -->
            @if (Model.Status == PadiPay.Models.OrderStatus.Delivered)
            {
                <div class="alert alert-warning border-2 p-4 mb-4 shadow-sm rounded-3">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-bell-fill fs-3 text-warning"></i>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">Deliverables Submitted for Review!</h5>
                            <p class="mb-3 small">
                                @if (isBuyer)
                                {
                                    <span>The freelancer has submitted the completed deliverables below. Please inspect the code, demo, and attachments. If satisfied, click <strong>Accept Delivery & Release Funds</strong>. If you need modifications, you can request a revision.</span>
                                }
                                else
                                {
                                    <span>You have submitted your deliverables. The buyer is currently reviewing the work. Payment will be released upon buyer acceptance.</span>
                                }
                            </p>

                            @if (isBuyer)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    <form asp-action="AcceptDelivery" asp-route-id="@Model.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-emerald fw-bold px-4 py-2 shadow-xs" 
                                                onclick="return confirm('Are you sure you want to accept this delivery? This will release ₦@Model.Amount.ToString("N0") from escrow to the seller.');">
                                            <i class="bi bi-check2-circle me-1"></i> Accept & Release Escrow Funds (₦@Model.Amount.ToString("N0"))
                                        </button>
                                    </form>

                                    @if (Model.RevisionsUsed < Model.AllowedRevisions)
                                    {
                                        <button type="button" class="btn btn-outline-secondary fw-semibold px-3 py-2" data-bs-toggle="collapse" data-bs-target="#revisionBox">
                                            <i class="bi bi-arrow-repeat me-1"></i> Request Revision (@(Model.AllowedRevisions - Model.RevisionsUsed) remaining)
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Revision Request Collapse Box (for Buyer) -->
                @if (isBuyer && Model.RevisionsUsed < Model.AllowedRevisions)
                {
                    <div class="collapse mb-4" id="revisionBox">
                        <div class="pp-card p-4 border border-warning shadow-sm">
                            <h5 class="fw-bold text-dark mb-2">Request Revisions</h5>
                            <p class="text-muted small mb-3">Explain clearly what changes or adjustments are required. The order will be placed back into revision for the freelancer to update.</p>
                            
                            <form asp-action="RequestRevision" method="post">
                                <input type="hidden" name="OrderId" value="@Model.Id" />
                                <div class="mb-3">
                                    <textarea name="RevisionNotes" rows="4" class="form-control pp-input" 
                                              placeholder="Describe what needs to be changed, fixed, or improved..." required minlength="10"></textarea>
                                </div>
                                <button type="submit" class="btn btn-warning fw-bold px-4 py-2">
                                    <i class="bi bi-send-fill me-1"></i> Submit Revision Request
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else if (Model.Status == PadiPay.Models.OrderStatus.Completed)
            {
                <div class="alert alert-success border-2 p-4 mb-4 shadow-sm rounded-3">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-patch-check-fill fs-2 text-success"></i>
                        <div>
                            <h5 class="fw-bold mb-1">Order Completed Successfully!</h5>
                            <p class="mb-0 small text-secondary">
                                The escrow funds of <strong>₦@Model.Amount.ToString("N0")</strong> were released to <strong>@(Model.Seller?.FullName ?? "the seller")</strong> on @Model.CompletedAt?.ToString("MMMM dd, yyyy").
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Review Section -->
                @if (Model.Review != null)
                {
                    <div class="pp-card p-4 mb-4 shadow-sm border-start border-4 border-warning">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-5 text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Model.Review.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </span>
                                <span class="fw-bold text-dark">@Model.Review.Rating.0 / 5.0</span>
                                <span class="badge bg-light text-success border small"><i class="bi bi-patch-check-fill"></i> Verified Purchase</span>
                            </div>
                            <small class="text-muted">@Model.Review.CreatedAt.ToString("MMM dd, yyyy")</small>
                        </div>
                        <p class="text-secondary mb-2" style="white-space: pre-line; line-height: 1.6;">@Model.Review.Comment</p>
                        <div class="text-muted small">
                            Reviewed by <strong>@(Model.Buyer?.FullName ?? "Client")</strong>
                        </div>
                    </div>
                }
                else if (isBuyer)
                {
                    <div class="pp-card p-4 mb-4 shadow-sm border-2 border-warning" style="background: linear-gradient(135deg, rgba(254, 243, 199, 0.3), rgba(255, 255, 255, 0.95));">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fs-4 text-warning">⭐</span>
                                    <h5 class="fw-bold mb-0 text-dark">How was your experience?</h5>
                                </div>
                                <p class="text-muted small mb-0">
                                    Rate <strong>@(Model.Seller?.FullName ?? "the freelancer")</strong> and leave a review to help other Nigerian clients.
                                </p>
                            </div>
                            <div>
                                <a asp-controller="Review" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-warning fw-bold px-4 py-2.5 shadow-xs text-dark text-nowrap">
                                    <i class="bi bi-star-fill me-1"></i> Leave a Review
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- Seller Delivery Action Form (Shown when InProgress or InRevision) -->
            @if (isSeller && (Model.Status == PadiPay.Models.OrderStatus.InProgress || Model.Status == PadiPay.Models.OrderStatus.InRevision))
            {
                <div class="pp-card p-4 mb-4 shadow-sm border border-primary border-opacity-25" style="background: rgba(0, 192, 118, 0.02);">
                    <h5 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                        <i class="bi bi-cloud-upload-fill text-primary"></i> Submit Deliverables
                    </h5>
                    <p class="text-muted small mb-3">
                        Deliver your completed work to the buyer. Provide live preview links, GitHub repositories, and optional zipped project files.
                    </p>

                    <form asp-action="Deliver" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="OrderId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Delivery Message & Notes *</label>
                            <textarea name="Message" rows="4" class="form-control pp-input" 
                                      placeholder="Summarize the work done, credentials, deployment instructions, or setup guide..." required minlength="10"></textarea>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-dark">Live Preview URL (Optional)</label>
                                <input type="url" name="LivePreviewUrl" class="form-control pp-input" placeholder="https://my-app.azurewebsites.net" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-dark">GitHub / Repo URL (Optional)</label>
                                <input type="url" name="GithubRepoUrl" class="form-control pp-input" placeholder="https://github.com/my-repo" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-dark">Attachment / Deliverable File (Optional)</label>
                            <input type="file" name="DeliverableFile" class="form-control pp-input" accept=".zip,.rar,.pdf,.png,.jpg,.jpeg" />
                            <div class="form-text small text-muted">Allowed: .zip, .rar, .pdf, images (Max: 20MB).</div>
                        </div>

                        <button type="submit" class="btn btn-emerald fw-bold px-4 py-2.5 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Deliver Completed Work
                        </button>
                    </form>
                </div>
            }

            <!-- Deliveries History Section -->
            @if (Model.Deliveries.Any())
            {
                <div class="pp-card p-4 mb-4 shadow-sm">
                    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam text-success"></i> Deliverables & Submissions (@Model.Deliveries.Count)
                    </h5>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var delivery in Model.Deliveries)
                        {
                            <div class="p-3 p-md-4 rounded-3 border bg-white shadow-xs">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <span class="fw-bold text-dark small">Submission</span>
                                    </div>
                                    <span class="text-muted small" style="font-size: 0.78rem;">
                                        @delivery.DeliveredAt.ToString("MMM dd, yyyy 'at' hh:mm tt")
                                    </span>
                                </div>

                                <div class="text-secondary small mb-3" style="white-space: pre-line; line-height: 1.6;">
                                    @delivery.Message
                                </div>

                                <!-- Links & Download Buttons -->
                                <div class="d-flex flex-wrap gap-2">
                                    @if (!string.IsNullOrEmpty(delivery.LivePreviewUrl))
                                    {
                                        <a href="@delivery.LivePreviewUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill">
                                            <i class="bi bi-globe me-1"></i> Open Live Preview
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(delivery.GithubRepoUrl))
                                    {
                                        <a href="@delivery.GithubRepoUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-dark rounded-pill">
                                            <i class="bi bi-github me-1"></i> View GitHub Repo
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(delivery.DeliverableFileUrl))
                                    {
                                        <a href="@delivery.DeliverableFileUrl" download class="btn btn-sm btn-success rounded-pill text-white">
                                            <i class="bi bi-download me-1"></i> Download Deliverable
                                        </a>
                                    }
                                </div>

                                <!-- Revision Feedback Tag (if this delivery had a revision) -->
                                @if (!string.IsNullOrEmpty(delivery.RevisionNotes))
                                {
                                    <div class="mt-3 p-2.5 rounded-2 bg-warning bg-opacity-10 border border-warning text-dark small">
                                        <strong class="text-dark"><i class="bi bi-arrow-repeat me-1"></i> Revision Requested:</strong>
                                        <div class="mt-1">@delivery.RevisionNotes</div>
                                        <div class="text-muted mt-1" style="font-size: 0.72rem;">@delivery.RevisionRequestedAt?.ToString("MMM dd, yyyy hh:mm tt")</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Buyer Requirements Section -->
            <div class="pp-card p-4 shadow-sm">
                <h5 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard-check text-primary"></i> Project Brief & Requirements
                </h5>
                <p class="text-muted small mb-3">Submitted by <strong>@(Model.Buyer?.FullName ?? "the buyer")</strong> at checkout:</p>
                <div class="bg-light p-3 rounded-3 text-dark small" style="white-space: pre-line; line-height: 1.7;">
                    @Model.BuyerRequirements
                </div>
            </div>
        </div>

        <!-- Right Column: Order Details & Counterparty Info -->
        <div class="col-lg-4">
            <div class="d-flex flex-column gap-4">
                <!-- Order Summary Card -->
                <div class="pp-card p-4 shadow-sm">
                    <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                        Escrow Contract
                    </h6>

                    <div class="d-flex flex-column gap-2.5 small text-muted">
                        <div class="d-flex justify-content-between">
                            <span>Service:</span>
                            <span class="text-dark fw-semibold text-truncate ms-2" style="max-width: 180px;">@Model.Gig?.Title</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Category:</span>
                            <span class="badge bg-light text-dark border">@(Model.Gig?.Category?.Name ?? "Tech")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Escrow Amount:</span>
                            <strong class="text-success fs-6">₦@Model.Amount.ToString("N0")</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Turnaround:</span>
                            <span class="text-dark">@Model.DeliveryDays Days</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Revisions:</span>
                            <span class="text-dark">@Model.RevisionsUsed of @Model.AllowedRevisions Used</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Order Placed:</span>
                            <span class="text-dark">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>

                <!-- Seller Profile Card -->
                <div class="pp-card p-4 shadow-sm">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-2">Freelancer</span>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.Seller?.ProfilePictureUrl))
                        {
                            <img src="@Model.Seller.ProfilePictureUrl" alt="@Model.Seller.FullName" class="rounded-circle border" style="width: 48px; height: 48px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="pp-seller-avatar" style="width: 48px; height: 48px; font-size: 1.15rem;">
                                @(string.IsNullOrWhiteSpace(Model.Seller?.FullName) ? "S" : Model.Seller.FullName.Trim()[0].ToString().ToUpper())
                            </div>
                        }
                        <div class="overflow-hidden">
                            <h6 class="mb-0 fw-bold text-dark text-truncate">@(Model.Seller?.FullName ?? "Freelancer")</h6>
                            <div class="text-muted small text-truncate">@(Model.Seller?.Headline ?? "Tech Pro")</div>
                            <div class="text-muted small"><i class="bi bi-geo-alt"></i> @(Model.Seller?.Location ?? "Nigeria")</div>
                        </div>
                    </div>
                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.SellerId" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                        View Freelancer Profile
                    </a>
                </div>

                <!-- Buyer Profile Card -->
                <div class="pp-card p-4 shadow-sm">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-2">Client (Buyer)</span>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.Buyer?.ProfilePictureUrl))
                        {
                            <img src="@Model.Buyer.ProfilePictureUrl" alt="@Model.Buyer.FullName" class="rounded-circle border" style="width: 48px; height: 48px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="pp-seller-avatar" style="width: 48px; height: 48px; font-size: 1.15rem; background: linear-gradient(135deg, #4f46e5, #00C076);">
                                @(string.IsNullOrWhiteSpace(Model.Buyer?.FullName) ? "B" : Model.Buyer.FullName.Trim()[0].ToString().ToUpper())
                            </div>
                        }
                        <div class="overflow-hidden">
                            <h6 class="mb-0 fw-bold text-dark text-truncate">@(Model.Buyer?.FullName ?? "Client")</h6>
                            <div class="text-muted small"><i class="bi bi-geo-alt"></i> @(Model.Buyer?.Location ?? "Nigeria")</div>
                            <div class="text-muted small">Member since @Model.Buyer?.JoinedAt.ToString("MMM yyyy")</div>
                        </div>
                    </div>
                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.BuyerId" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                        View Client Profile
                    </a>
                </div>

                <!-- Support & Escrow Notice -->
                <div class="p-3 rounded-3 bg-light border small text-muted">
                    <div class="d-flex align-items-center gap-2 mb-1 text-dark fw-bold">
                        <i class="bi bi-shield-lock-fill text-success fs-5"></i>
                        <span>Need Support?</span>
                    </div>
                    <p class="mb-0" style="font-size: 0.82rem;">
                        If you encounter an issue that cannot be resolved between buyer and seller, contact PadiPay Support for administrative mediation.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
