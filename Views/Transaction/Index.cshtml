@model List<PadiPay.Models.Transaction>

@{
    ViewData["Title"] = "My Transactions";
    var currentUserId = User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
}

<div class="pp-fade-in" style="max-width: 900px; margin: 2rem auto;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="font-weight: 700;">My Transactions</h2>
        <a asp-action="Create" class="btn btn-primary">+ New Transaction</a>
    </div>

    @if (!Model.Any())
    {
        <div class="pp-card text-center" style="color: var(--pp-text-muted);">
            No transactions yet. Start one above.
        </div>
    }
    else
    {
        @foreach (var t in Model)
        {
            <div class="pp-card mb-3 d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-weight: 600; font-size: 1.1rem;">₦@t.Amount.ToString("N2")</div>
                    <div style="color: var(--pp-text-muted); font-size: 0.85rem;">@t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="pp-badge pp-badge-@t.Status.ToString().ToLower()">@t.Status</span>

                    @if (t.SellerId == currentUserId && t.Status == PadiPay.Models.TransactionStatus.Funded)
                    {
                        <form asp-action="MarkDelivered" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="btn btn-sm btn-warning">Mark Delivered</button>
                        </form>
                    }
                    @if (t.BuyerId == currentUserId && t.Status == PadiPay.Models.TransactionStatus.Delivered)
                    {
                        <form asp-action="Release" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="btn btn-sm btn-success">Release Funds</button>
                        </form>
                    }
                </div>
            </div>
        }
    }
</div>