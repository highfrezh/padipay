@model List<PadiPay.Models.Gig>
@{
    ViewData["Title"] = "My Tech Gigs";
}

<div class="pp-fade-in" style="max-width: 1100px; margin: 1.5rem auto;">
    <!-- Dashboard Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="brand-font mb-0">My Tech Gigs</h2>
                <span class="badge bg-dark rounded-pill px-2.5 py-1.5">@Model.Count Gigs</span>
            </div>
            <p class="text-muted small mb-0">Manage your active service listings, track views, edit packages, or pause gigs.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Create New Gig</span>
        </a>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="pp-card p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success fs-4">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Active Gigs</div>
                    <h3 class="mb-0 brand-font">@Model.Count(g => g.IsActive)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pp-card p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning fs-4">
                    <i class="bi bi-pause-circle-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Paused Gigs</div>
                    <h3 class="mb-0 brand-font">@Model.Count(g => !g.IsActive)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pp-card p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary fs-4">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Escrow Protection</div>
                    <div class="text-success fw-bold small">Active & 100% Guaranteed</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gigs Listing Table / Grid -->
    @if (!Model.Any())
    {
        <div class="pp-card text-center p-5">
            <div class="display-4 text-muted mb-3"><i class="bi bi-briefcase"></i></div>
            <h4 class="brand-font">You haven't posted any gigs yet</h4>
            <p class="text-muted small mb-4" style="max-width: 480px; margin-inline: auto;">
                Start offering your programming, design, devops, or technical writing skills to thousands of clients across Nigeria.
            </p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Post Your First Gig
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var gig in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="pp-card pp-card-hover h-100 d-flex flex-column">
                        <!-- Cover Image -->
                        <div class="pp-gig-img-wrap">
                            @if (!string.IsNullOrEmpty(gig.CoverImageUrl))
                            {
                                <img src="@gig.CoverImageUrl" alt="@gig.Title" class="pp-gig-img" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-white-50">
                                    <i class="bi bi-code-square fs-1"></i>
                                </div>
                            }
                            <span class="pp-gig-category-badge">@gig.Category?.Name</span>
                        </div>

                        <!-- Card Body -->
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                @if (gig.IsActive)
                                {
                                    <span class="pp-badge pp-badge-released"><i class="bi bi-dot fs-5"></i> Active</span>
                                }
                                else
                                {
                                    <span class="pp-badge pp-badge-pending"><i class="bi bi-pause-fill"></i> Paused</span>
                                }
                                <span class="text-muted small"><i class="bi bi-clock me-1"></i>@gig.DeliveryDays Days</span>
                            </div>

                            <h5 class="pp-gig-title mb-2">
                                <a asp-action="Details" asp-route-id="@gig.Id" class="text-decoration-none text-dark">
                                    @gig.Title
                                </a>
                            </h5>

                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block">Price</span>
                                    <span class="pp-gig-price">₦@gig.Price.ToString("N0")</span>
                                </div>

                                <div class="d-flex align-items-center gap-1">
                                    <!-- Toggle Active/Pause -->
                                    <form asp-action="ToggleStatus" asp-route-id="@gig.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="@(gig.IsActive ? "Pause Gig" : "Activate Gig")">
                                            <i class="bi @(gig.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                        </button>
                                    </form>

                                    <!-- Edit Gig -->
                                    <a asp-action="Edit" asp-route-id="@gig.Id" class="btn btn-outline-primary btn-sm" title="Edit Gig">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <!-- View Public Details -->
                                    <a asp-action="Details" asp-route-id="@gig.Id" class="btn btn-sm btn-light border" title="Preview Public Page">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
