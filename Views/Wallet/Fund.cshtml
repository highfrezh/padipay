@{
    ViewData["Title"] = "Fund Wallet";
}

<h2>Fund Wallet</h2>

<form asp-action="Fund" method="post">
    <div class="form-group">
        <label for="amount">Amount (₦)</label>
        <input type="number" step="0.01" name="amount" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Add Funds</button>
</form>