@model PadiPay.Models.Wallet

@{
    ViewData["Title"] = "My Wallet";
}

<div class="pp-fade-in" style="max-width: 480px; margin: 2rem auto;">
    <div class="pp-card text-center">
        <p class="text-uppercase" style="color: var(--pp-text-muted); font-size: 0.85rem; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
            Wallet Balance
        </p>

        @if (Model == null)
        {
            <p>No wallet found.</p>
        }
        else
        {
            <h1 style="font-weight: 700; font-size: 2.5rem; color: var(--pp-text);">
                ₦@Model.Balance.ToString("N2")
            </h1>
        }

        <a asp-action="Fund" class="btn btn-primary mt-3 px-4">Fund Wallet</a>
    </div>
</div>