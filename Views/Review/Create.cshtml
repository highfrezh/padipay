@model PadiPay.ViewModels.CreateReviewViewModel
@{
    ViewData["Title"] = $"Review Order #{Model.OrderNumber} - PadiPay";
}

<div class="pp-fade-in pb-5" style="max-width: 860px; margin: 1.5rem auto;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Order" asp-action="Index" class="text-decoration-none text-muted">Orders</a></li>
            <li class="breadcrumb-item"><a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" class="text-decoration-none text-muted">#@Model.OrderNumber</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Leave Review</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="pp-card p-4 p-md-5 mb-4 shadow-sm border-0" 
         style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(240, 253, 244, 0.7)); border-left: 6px solid var(--pp-primary) !important;">
        <div class="row align-items-center g-4">
            <div class="col-md-8">
                <span class="pp-badge pp-badge-released mb-2 d-inline-block">
                    <i class="bi bi-shield-check me-1"></i> Order Completed & Escrow Released
                </span>
                <h2 class="fw-bold text-dark mb-2 brand-font">Rate Your Experience</h2>
                <p class="text-muted mb-0">
                    Your authentic feedback helps fellow Nigerian businesses and tech clients make confident hiring decisions.
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="d-inline-flex align-items-center gap-3 bg-white p-3 rounded-3 shadow-xs border">
                    @if (!string.IsNullOrEmpty(Model.SellerPictureUrl))
                    {
                        <img src="@Model.SellerPictureUrl" alt="@Model.SellerName" class="rounded-circle border" style="width: 44px; height: 44px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="pp-seller-avatar" style="width: 44px; height: 44px; font-size: 1.1rem;">
                            @(string.IsNullOrWhiteSpace(Model.SellerName) ? "S" : Model.SellerName.Trim()[0].ToString().ToUpper())
                        </div>
                    }
                    <div class="text-start">
                        <div class="fw-bold text-dark small">@Model.SellerName</div>
                        <div class="text-muted" style="font-size: 0.75rem;">@(Model.SellerHeadline ?? "Freelancer")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Review Form Card -->
    <div class="pp-card p-4 p-md-5 shadow-sm">
        <form asp-action="Create" method="post" id="reviewForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="OrderId" />
            <input type="hidden" asp-for="GigId" />
            <input type="hidden" asp-for="SellerId" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <!-- Gig Context Summary -->
            <div class="d-flex align-items-center gap-3 p-3 mb-4 rounded-3 bg-light border">
                @if (!string.IsNullOrEmpty(Model.GigCoverImageUrl))
                {
                    <img src="@Model.GigCoverImageUrl" alt="@Model.GigTitle" class="rounded border" style="width: 60px; height: 60px; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-secondary" style="width: 60px; height: 60px;">
                        <i class="bi bi-briefcase fs-4"></i>
                    </div>
                }
                <div>
                    <span class="badge bg-white text-muted border small mb-1">Order #@Model.OrderNumber</span>
                    <h6 class="fw-bold text-dark mb-0">@Model.GigTitle</h6>
                </div>
            </div>

            <!-- Interactive Star Rating Input -->
            <div class="mb-4 text-center p-4 rounded-3 border bg-white">
                <label class="form-label fw-bold fs-5 text-dark d-block mb-2">Overall Satisfaction Rating</label>
                <p class="text-muted small mb-3">Click on a star to set your rating</p>

                <div class="d-inline-flex flex-row-reverse justify-content-center gap-2 star-rating-container fs-1" id="starContainer">
                    <input type="radio" asp-for="Rating" value="5" id="star5" class="d-none star-radio" checked />
                    <label for="star5" class="star-label bi bi-star-fill text-warning" title="5 Stars - Exceptional"></label>

                    <input type="radio" asp-for="Rating" value="4" id="star4" class="d-none star-radio" />
                    <label for="star4" class="star-label bi bi-star-fill text-warning" title="4 Stars - Very Good"></label>

                    <input type="radio" asp-for="Rating" value="3" id="star3" class="d-none star-radio" />
                    <label for="star3" class="star-label bi bi-star-fill text-warning" title="3 Stars - Average"></label>

                    <input type="radio" asp-for="Rating" value="2" id="star2" class="d-none star-radio" />
                    <label for="star2" class="star-label bi bi-star-fill text-warning" title="2 Stars - Poor"></label>

                    <input type="radio" asp-for="Rating" value="1" id="star1" class="d-none star-radio" />
                    <label for="star1" class="star-label bi bi-star-fill text-warning" title="1 Star - Very Poor"></label>
                </div>

                <div class="mt-2 fw-semibold fs-6 text-success" id="ratingText">
                    ⭐⭐⭐⭐⭐ Exceptional (5 / 5)
                </div>
                <span asp-validation-for="Rating" class="text-danger small d-block mt-1"></span>
            </div>

            <!-- Written Comment -->
            <div class="mb-4">
                <label asp-for="Comment" class="form-label fw-bold text-dark">
                    Detailed Review & Feedback <span class="text-danger">*</span>
                </label>
                <textarea asp-for="Comment" class="form-control" rows="5" 
                          placeholder="Describe the quality of delivery, communication, adherence to deadline, and technical competence..."
                          maxlength="1500" required></textarea>
                <div class="d-flex justify-content-between mt-1">
                    <span asp-validation-for="Comment" class="text-danger small"></span>
                    <small class="text-muted" id="charCount">0 / 1500 characters</small>
                </div>
            </div>

            <!-- Review Notice -->
            <div class="alert alert-light border small text-muted mb-4 d-flex align-items-start gap-2">
                <i class="bi bi-info-circle-fill text-primary mt-0.5"></i>
                <div>
                    Once submitted, your rating and feedback will be displayed publicly on <strong>@Model.SellerName's</strong> profile and this gig listing to help other tech buyers.
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="d-flex gap-3 justify-content-end">
                <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary px-4 py-2.5">
                    Cancel
                </a>
                <button type="submit" class="btn btn-emerald px-5 py-2.5 fs-6 shadow-sm">
                    <i class="bi bi-check-circle-fill me-1"></i> Submit Review
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .star-rating-container {
            direction: rtl;
        }
        .star-label {
            cursor: pointer;
            transition: transform 0.15s ease, color 0.15s ease;
            color: #d1d5db;
        }
        .star-radio:checked ~ .star-label,
        .star-label:hover,
        .star-label:hover ~ .star-label {
            color: #f59e0b !important;
            transform: scale(1.15);
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const starRadios = document.querySelectorAll('.star-radio');
            const ratingText = document.getElementById('ratingText');
            const commentArea = document.getElementById('Comment');
            const charCount = document.getElementById('charCount');

            const ratingDescriptions = {
                5: '⭐⭐⭐⭐⭐ Exceptional (5 / 5)',
                4: '⭐⭐⭐⭐ Very Good (4 / 5)',
                3: '⭐⭐⭐ Average (3 / 5)',
                2: '⭐⭐ Poor (2 / 5)',
                1: '⭐ Very Poor (1 / 5)'
            };

            function updateRatingDisplay(val) {
                if (ratingDescriptions[val]) {
                    ratingText.innerText = ratingDescriptions[val];
                }
            }

            starRadios.forEach(radio => {
                radio.addEventListener('change', function () {
                    updateRatingDisplay(this.value);
                });
                if (radio.checked) {
                    updateRatingDisplay(radio.value);
                }
            });

            if (commentArea && charCount) {
                const updateCount = () => {
                    charCount.innerText = `${commentArea.value.length} / 1500 characters`;
                };
                commentArea.addEventListener('input', updateCount);
                updateCount();
            }
        });
    </script>
}
