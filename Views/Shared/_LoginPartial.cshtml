@using Microsoft.AspNetCore.Identity
@using PadiPay.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-1">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link pp-badge pp-badge-delivered text-decoration-none px-2 py-1 me-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                🛡️ Admin Portal
            </a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link fw-semibold text-dark" asp-area="" asp-controller="Wallet" asp-action="Index" title="My Account">
            👤 @(User.Identity?.Name?.Split('@')[0] ?? "Account")
        </a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="btn btn-outline-secondary btn-sm px-3 py-1">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark fw-medium" id="login" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
    </li>
    <li class="nav-item ms-1">
        <a class="btn btn-primary btn-sm px-3 py-1 text-white" id="register" asp-area="Identity" asp-page="/Account/Register">Join PadiPay</a>
    </li>
}
</ul>
