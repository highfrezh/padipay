@model IEnumerable<PadiPay.Models.OrderDispute>
@{
    ViewData["Title"] = "Dispute Center";
    ViewData["PageIcon"] = "bi-exclamation-triangle-fill";
    var activeFilter = ViewBag.ActiveFilter as string ?? "open";
    int openCount = ViewBag.OpenCount ?? 0;
    int reviewCount = ViewBag.ReviewCount ?? 0;
    int resolvedCount = ViewBag.ResolvedCount ?? 0;
}

<!-- Filter Tabs -->
<div class="d-flex gap-2 mb-4 flex-wrap">
    <a asp-area="Admin" asp-controller="Dispute" asp-action="Index" asp-route-filter="open"
       class="btn rounded-pill @(activeFilter == "open" ? "btn-danger" : "btn-outline-secondary")" style="font-size: 0.83rem;">
        <i class="bi bi-exclamation-circle-fill me-1"></i> Open
        <span class="badge rounded-pill ms-1 @(activeFilter == "open" ? "bg-white text-danger" : "bg-secondary text-white")" style="font-size: 0.65rem;">@openCount</span>
    </a>
    <a asp-area="Admin" asp-controller="Dispute" asp-action="Index" asp-route-filter="review"
       class="btn rounded-pill @(activeFilter == "review" ? "btn-warning text-dark" : "btn-outline-secondary")" style="font-size: 0.83rem;">
        <i class="bi bi-eye-fill me-1"></i> Under Review
        <span class="badge rounded-pill ms-1 @(activeFilter == "review" ? "bg-dark text-white" : "bg-secondary text-white")" style="font-size: 0.65rem;">@reviewCount</span>
    </a>
    <a asp-area="Admin" asp-controller="Dispute" asp-action="Index" asp-route-filter="resolved"
       class="btn rounded-pill @(activeFilter == "resolved" ? "btn-success text-white" : "btn-outline-secondary")" style="font-size: 0.83rem;">
        <i class="bi bi-check-circle-fill me-1"></i> Resolved
        <span class="badge rounded-pill ms-1 @(activeFilter == "resolved" ? "bg-white text-success" : "bg-secondary text-white")" style="font-size: 0.65rem;">@resolvedCount</span>
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5" style="background: #fff; border-radius: 16px; border: 1px solid #E5EAF2;">
        <div style="font-size: 3rem; margin-bottom: 0.75rem;">
            @(activeFilter == "resolved" ? "✅" : "🎉")
        </div>
        <h5 class="fw-bold text-dark">@(activeFilter == "resolved" ? "No resolved disputes yet" : "No disputes in this queue!")</h5>
        <p class="text-muted small">@(activeFilter == "open" ? "The marketplace is running smoothly — no open disputes." : "Nothing here.")</p>
    </div>
}
else
{
    <div class="admin-table-card">
        <div class="admin-section-header">
            <h6>
                <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>
                @(activeFilter switch { "open" => "Open Disputes", "review" => "Under Admin Review", _ => "Resolved Disputes" })
                (@Model.Count())
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Raised By</th>
                        <th>Reason</th>
                        <th>Escrow Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        var badgeCls = d.Status switch {
                            PadiPay.Models.DisputeStatus.Open => "badge-admin-open",
                            PadiPay.Models.DisputeStatus.UnderReview => "badge-admin-review",
                            PadiPay.Models.DisputeStatus.ResolvedRefundBuyer => "badge-admin-resolved",
                            PadiPay.Models.DisputeStatus.ResolvedPayoutSeller => "badge-admin-resolved",
                            _ => "badge-admin-cancelled"
                        };
                        var statusLabel = d.Status switch {
                            PadiPay.Models.DisputeStatus.Open => "Open",
                            PadiPay.Models.DisputeStatus.UnderReview => "Under Review",
                            PadiPay.Models.DisputeStatus.ResolvedRefundBuyer => "Refunded Buyer",
                            PadiPay.Models.DisputeStatus.ResolvedPayoutSeller => "Paid Seller",
                            _ => "Cancelled"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark small">#@(d.Order?.OrderNumber ?? "N/A")</div>
                                <div class="text-muted" style="font-size: 0.7rem; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @(d.Order?.Gig?.Title ?? "Gig unavailable")
                                </div>
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark">@(d.Initiator?.FullName ?? "Unknown")</div>
                                <div class="text-muted" style="font-size: 0.7rem;">@(d.Initiator?.Email ?? "")</div>
                            </td>
                            <td>
                                <span class="small text-dark" style="max-width: 160px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @d.Reason
                                </span>
                            </td>
                            <td class="fw-bold small" style="color: #DC2626;">₦@((d.Order?.Amount ?? 0m).ToString("N0"))</td>
                            <td>
                                <span class="badge rounded-pill @badgeCls px-2 py-1" style="font-size: 0.7rem;">@statusLabel</span>
                            </td>
                            <td class="text-muted small">@d.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a asp-area="Admin" asp-controller="Dispute" asp-action="Details" asp-route-id="@d.Id"
                                   class="btn btn-sm btn-outline-primary rounded-pill" style="font-size: 0.72rem;">
                                    <i class="bi bi-eye me-1"></i>
                                    @(d.Status == PadiPay.Models.DisputeStatus.ResolvedRefundBuyer || d.Status == PadiPay.Models.DisputeStatus.ResolvedPayoutSeller ? "View" : "Arbitrate")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
